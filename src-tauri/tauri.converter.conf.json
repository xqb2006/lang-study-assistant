{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "阅读内容转换器",
  "version": "1.0.0",
  "identifier": "com.readingagent.converter",
  "build": {
    "beforeBuildCommand": "npm run build:converter",
    "frontendDist": "../converter-dist"
  },
  "app": {
    "windows": [{
      "title": "阅读内容转换器",
      "width": 1200,
      "height": 760,
      "minWidth": 960,
      "minHeight": 560
    }],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": "nsis",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/icon.ico"]
  }
}
